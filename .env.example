# ==========================================
# ZEESHAN AI YOUTUBE LAB
# Environment Configuration Template
# ==========================================

NODE_ENV=development

# ------------------------------------------
# SYSTEM
# ------------------------------------------

APP_NAME=ZEESHAN_AI_YOUTUBE_LAB
APP_VERSION=1.0.0

SYSTEM_MODE=REVIEW
MAX_DAILY_VIDEOS=5

CEO_APPROVAL_REQUIRED=true
EMERGENCY_STOP=false

# ------------------------------------------
# TARGET AUDIENCE
# ------------------------------------------

TARGET_REGIONS=US,GB,DE,FR,IT,ES,NL
TARGET_LANGUAGE=en

# ------------------------------------------
# VIDEO
# ------------------------------------------

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

VIDEO_MIN_SECONDS=20
VIDEO_MAX_SECONDS=59

# ------------------------------------------
# SAFETY
# ------------------------------------------

SAFETY_MODE=strict

AUTO_PUBLISH_LOW_RISK=false
REVIEW_MEDIUM_RISK=true
BLOCK_HIGH_RISK=true

# ------------------------------------------
# AI PROVIDER
# ------------------------------------------

AI_PROVIDER=

AI_API_KEY=

AI_MODEL=

# ------------------------------------------
# TRENDS
# ------------------------------------------

TREND_LOOKBACK_HOURS=24
MAX_TREND_TOPICS=20

# ------------------------------------------
# YOUTUBE
# ------------------------------------------

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

YOUTUBE_PRIVACY_STATUS=private

# ------------------------------------------
# STORAGE
# ------------------------------------------

STORAGE_PROVIDER=local

# ------------------------------------------
# LOGGING
# ------------------------------------------

LOG_LEVEL=info
